# --- Supabase (cliente) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (servidor, sólo /api/*) ---
# Necesaria para que el panel admin y las rutas de borrado funcionen.
# NUNCA la pongas en variables NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# --- Bodas / acceso ---
# Lista de eventos en formato slug:PIN separados por coma.
# Ejemplo: teresa-pablo:TP2026,maria-juan:MJ0925
EVENT_PINS=teresa-pablo:TP2026
NEXT_PUBLIC_EVENT_PINS=teresa-pablo:TP2026

# Bucket de Supabase Storage donde se guardan fotos y vídeos
NEXT_PUBLIC_STORAGE_BUCKET=wedding

# --- Admin ---
# Clave maestra para entrar a /admin (cámbiala antes de desplegar).
ADMIN_KEY=cambia-esta-clave-larga-y-aleatoria

# URL pública de despliegue, usada para generar el QR en /admin/qr
NEXT_PUBLIC_SITE_URL=https://behelpyou.com
